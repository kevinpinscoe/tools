#!/usr/bin/env bash
# Shared implementation behind the `rg` and `ugrep` PATH shims (see the `rg`
# and `ugrep` symlinks beside this file). Invoked as whichever name it was
# called by, so it looks up the real binary under that same name.
#
# Purpose: require an interactive human "yes" before running rg/ugrep at all.
# A non-interactive caller (an AI agent's Bash tool, a sandboxed exec, a
# script) has no TTY to answer the prompt with, so it is denied outright
# rather than left waiting on stdin. See FLDW-50 and
# ~/ai/directives/unscoped-recursive-searches.md for why this exists.
set -euo pipefail

cmd_name=$(basename -- "$0")
self_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

# Find the real binary under this same name, skipping our own shim
# directory so we don't just exec ourselves again.
real_bin=""
IFS=':' read -r -a path_dirs <<< "$PATH"
for dir in "${path_dirs[@]}"; do
  [ -n "$dir" ] || continue
  [ "$dir" = "$self_dir" ] && continue
  candidate="$dir/$cmd_name"
  if [ -x "$candidate" ]; then
    real_bin="$candidate"
    break
  fi
done

if [ -z "$real_bin" ]; then
  echo "$cmd_name: no real '$cmd_name' binary found on \$PATH outside $self_dir" >&2
  exit 127
fi

# Fail closed: only a real interactive terminal on stdin can answer the
# prompt below. Anything else (a pipe, /dev/null, a sandboxed non-tty exec)
# is denied without prompting.
if [ ! -t 0 ]; then
  echo "$cmd_name: blocked -- not an interactive terminal. Only a human is authorized to run this command." >&2
  exit 1
fi

reply=""
if ! read -r -t 15 -p "Are you human? Only a human is authorized to run this command. [y/N] " reply; then
  echo "" >&2
  echo "$cmd_name: no answer received -- denying." >&2
  exit 1
fi

case "$reply" in
  y|Y|yes|YES|Yes)
    exec "$real_bin" "$@"
    ;;
  *)
    echo "$cmd_name: not confirmed -- denying." >&2
    exit 1
    ;;
esac
