#!/usr/bin/env bash
#
# agent-credential-guard -- refuse to start an AI coding agent from a shell that
# carries an elevated OpenBao session.
#
#   agent-credential-guard [launcher-name]     exit 0 = fine, 77 = refused
#
# Called by myclaude, mycodex and myclaude-screen before they start anything.
#
# WHY. An administrator authenticates to OpenBao for one shell with `bao-auth`,
# which puts the session in that shell's environment. Every process started
# from that shell inherits it -- so an agent launched there would hold
# administrator authority over the secret store, and its tool calls would too.
# This check is mistake prevention, not a security boundary: it only covers the
# launchers that call it. A bare `claude` or `codex` typed in the same shell is
# not stopped by anything here.
#
# WHAT IT REFUSES. It names variables, never values:
#   - anywhere: OPENBAO_ADMIN_SESSION is set (the flag `bao-auth` exports);
#   - on macOS, where an ordinary shell has no OpenBao token in its environment:
#     BAO_TOKEN or VAULT_TOKEN is set;
#   - in a container that mounts the Mac home at /mac-home, where an ordinary
#     shell's BAO_TOKEN is the injected one in /dev/shm: VAULT_TOKEN is set, or
#     BAO_TOKEN is set and is not that injected token.
# On any other host only the flag is checked, because other hosts may export a
# token in ordinary shells and this script cannot tell which are elevated.
#
# There is deliberately no override flag and no override variable. Start the
# agent from a different terminal.

set -uo pipefail

who="${1:-agent launcher}"
reasons=()

[ -n "${OPENBAO_ADMIN_SESSION:-}" ] && \
  reasons+=("OPENBAO_ADMIN_SESSION is set: this shell holds an administrator session from bao-auth")

if [ "$(uname -s)" = "Darwin" ]; then
  [ -n "${BAO_TOKEN:-}" ]   && reasons+=("BAO_TOKEN is set: an ordinary shell on this host has none")
  [ -n "${VAULT_TOKEN:-}" ] && reasons+=("VAULT_TOKEN is set: an ordinary shell on this host has none")
elif [ -d /mac-home ]; then
  [ -n "${VAULT_TOKEN:-}" ] && reasons+=("VAULT_TOKEN is set: an ordinary shell in this container has none")
  if [ -n "${BAO_TOKEN:-}" ]; then
    cache="/dev/shm/.bao-token-$(id -u)"
    injected=""
    [ -r "$cache" ] && injected="$(tr -d '\r\n' < "$cache")"
    [ "$BAO_TOKEN" = "$injected" ] || \
      reasons+=("BAO_TOKEN is set and is not the token injected into this container")
    injected=""
  fi
fi

[ "${#reasons[@]}" -eq 0 ] && exit 0

{
  printf '%s: refused to start an AI agent from this shell.\n' "$who"
  for r in "${reasons[@]}"; do printf '  - %s\n' "$r"; done
  printf '  An agent started here would inherit that session, and so would every command it runs.\n'
  printf '  Close this terminal when the administration is finished, and start the agent from another one.\n'
} >&2
exit 77
