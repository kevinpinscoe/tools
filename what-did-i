#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  cat >&2 <<EOF
Usage: what-did-i [yesterday | YYYY-MM-DD] [-h|--help]

Fetch today's git commits from GitHub and Gitea and write a markdown
summary to the journal ACCOMPLISHMENTS directory.

Arguments:
  yesterday   Use yesterday's date instead of today's.
  YYYY-MM-DD  Use this specific date (for backfilling a missed day).
  -h, --help  Show this help message and exit.
EOF
}

for arg in "$@"; do
  case "$arg" in
    -h|--help) usage; exit 0 ;;
  esac
done

case "$(uname -s)" in
  Linux)  export JOURNAL_PATH="$HOME/Journal/personal-journal/personal-journal" ;;
  Darwin) export JOURNAL_PATH="$HOME/Journal/Professional/Professional" ;;
  *)      echo "what-did-i: unsupported OS '$(uname -s)'" >&2; exit 1 ;;
esac

# Deliver the Gitea token via parzival (identity what-did-i, KSA-23) when
# that AppRole is provisioned on this host; otherwise the .py's own
# VAULT_TOKEN_FILE fallback still applies.
#
# Not on work-macbook (AI-85). There is no what-did-i AppRole or
# what-did-i-gitea profile there, and this call sets no PARZIVAL_OPENBAO_AUTH,
# so parzival would run in its ambient compatibility mode: a `bao` subprocess
# that authenticates through the CLI's token helper, which on the Mac is the
# administrator's (POE-43). The .py reads app/gitea there through work-ai-bao,
# with the restricted Work-AI token only.
if [ "$(uname -s)" != Darwin ] && command -v parzival >/dev/null 2>&1; then
  exec parzival exec --as what-did-i what-did-i-gitea -- python3 "$SCRIPT_DIR/what-did-i-accomplish-today.py" "$@"
fi
exec python3 "$SCRIPT_DIR/what-did-i-accomplish-today.py" "$@"
